{
  "name": "imsli-license-server",
  "version": "0.6.1",
  "private": true,
  "description": "License server and admin panel for IndiaMART Smart Lead Intelligence.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:admin",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p admin-ui/tsconfig.json",
    "admin:key": "tsx src/cli/admin-key.ts",
    "build:admin": "vite build --config admin-ui/vite.config.ts",
    "dev:admin": "vite build --watch --mode development --config admin-ui/vite.config.ts",
    "dev:panel": "npm run build:admin && tsx src/dev-memory.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.10.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
