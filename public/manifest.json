{
  "manifest_version": 3,
  "name": "IndiaMART Smart Lead Intelligence",
  "short_name": "Lead Intelligence",
  "version": "0.6.1",
  "description": "Scans, scores, and classifies leads in IndiaMART Lead Manager. Actions stay under your control.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lead Intelligence",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://seller.indiamart.com/*", "__LICENSE_API_ORIGIN__/*"],
  "content_scripts": [
    {
      "matches": ["https://seller.indiamart.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
